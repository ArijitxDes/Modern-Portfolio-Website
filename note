function pointerskew() {
    let xprev = 0;
    let yprev = 0;

    window.addEventListener("mousemove", (dets) => {
        clearTimeout(timeout);

        let xscale=gsap.utils.clamp(0.6,1.2,dets.clientX - xprev);
        let yscale=gsap.utils.clamp(0.6,1.2,dets.clientY - yprev);

        xprev = dets.clientX;
        yprev = dets.clientY;

        pointer.style.transform =
            `translate(${dets.clientX}px, ${dets.clientY}px) scale(${xscale}, ${yscale})`;

        timeout = setTimeout(() => {
            pointer.style.transform =
                `translate(${dets.clientX}px, ${dets.clientY}px) scale(1, 1)`;
        }, 100);
    });
}